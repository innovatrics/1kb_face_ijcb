diff --git a/src/__init__.py b/src/__init__.py
index 91462da..fc3abf9 100644
--- a/src/__init__.py
+++ b/src/__init__.py
@@ -29,3 +29,20 @@
 # CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
 # ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
 # THE POSSIBILITY OF SUCH DAMAGE.
+
+# ---------------------------------------------------------------------------
+# Compatibility patch for PyTorch >= 2.6 which defaults weights_only=True
+# in torch.load(). The JPEG-AI reference software was written for torch 1.10
+# and relies on the old default (weights_only=False).
+# ---------------------------------------------------------------------------
+import functools as _functools
+import torch as _torch
+
+_orig_torch_load = _torch.load
+
+@_functools.wraps(_orig_torch_load)
+def _patched_torch_load(*args, **kwargs):
+    kwargs.setdefault("weights_only", False)
+    return _orig_torch_load(*args, **kwargs)
+
+_torch.load = _patched_torch_load
diff --git a/src/codec/entropy_coding/binarizers.py b/src/codec/entropy_coding/binarizers.py
index 635b36f..9d7209f 100644
--- a/src/codec/entropy_coding/binarizers.py
+++ b/src/codec/entropy_coding/binarizers.py
@@ -43,7 +43,7 @@ class Binarizers:
     @staticmethod
     def decode_unsigned_unary(bypass_coder) -> int:
         ans = 0
-        while bypass_coder.decode(1, max_symbol_value=1) == 0:
+        while bypass_coder.decode(1, max_symbol_value=1)[0] == 0:
             ans += 1
         return ans
     
@@ -59,7 +59,7 @@ class Binarizers:
     def decode_unsigned_expgolomb_k0(bypass_coder) -> int:
         data_size = Binarizers.decode_unsigned_unary(bypass_coder)
         max_v = 2**data_size-1
-        value = int(bypass_coder.decode(1, max_symbol_value=max_v))
+        value = int(bypass_coder.decode(1, max_symbol_value=max_v)[0])
         ans = (1 << data_size) + (value - 1)
         return ans
         
